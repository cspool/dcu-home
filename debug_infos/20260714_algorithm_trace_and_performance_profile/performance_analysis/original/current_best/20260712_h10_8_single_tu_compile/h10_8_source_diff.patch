+#pragma unroll
+  for (int mask = WARP_SIZE / 2; mask >= 1; mask /= 2) {
+#pragma unroll
+    for (int row_offset = 0; row_offset < NUM_A_ROWS_PER_BLOCK;
+         ++row_offset) {
+      acc[row_offset] += __shfl_xor(acc[row_offset], mask);
+    }
+  }
